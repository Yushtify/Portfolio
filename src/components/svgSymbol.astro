---
import { isActionError } from "astro:actions";

interface Props {
    givenID?: string;
    givenSvgSymbol?: string;
    givenSvgSymbolSize?: string;
    isFilled?: boolean;
    givenViewBox?: string;
}
const {
    givenID,
    givenSvgSymbol,
    givenSvgSymbolSize,
    givenViewBox = "0 0 24 24",
} = Astro.props;

const isActive = givenSvgSymbol ? "inline-block" : "!hidden";
const ValidStyleMap = {
    validWidth: givenSvgSymbolSize,
    validHeight: givenSvgSymbolSize,
};
const ValidID = givenID ? givenID : "MaterialSymbol";
---

<svg
    id={ValidID}
    class={isActive}
    width={ValidStyleMap.validWidth}
    height={ValidStyleMap.validHeight}
    viewBox={givenViewBox}
>
    <path fill="currentColor" d={givenSvgSymbol} />
</svg>
