---
import MaterialSymbol from "../materialSymbol.astro";

const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path;

interface Props {
    givenFunction: string;
    givenSymbol?: string;

    givenLocationFrom?: "horizontal" | "vertical";
    givenLocation?: "start" | "center" | "end";
    titleHiddenWhen?: "xs" | "sm" | "md" | "lg" | "xl";

    givenTitle?: string;
    givenTitleData?: string;
}

const {
    givenFunction,
    givenSymbol,
    givenLocationFrom,
    givenLocation,
    titleHiddenWhen,
    givenTitle,
    givenTitleData,
} = Astro.props;

// validate button rounded
const borderRadiusMap = {
    horizontal: {
        start: "rounded-xl rounded-l-3xl",
        center: "rounded-xl",
        end: "rounded-xl rounded-r-3xl",
    },
    vertical: {
        start: "rounded-xl rounded-t-3xl",
        center: "rounded-xl",
        end: "rounded-xl rounded-b-3xl",
    },
} as const;

const borderRadius =
    givenLocationFrom && givenLocation
        ? borderRadiusMap[givenLocationFrom][givenLocation]
        : "rounded-3xl";
const validBorderRadius = `${borderRadius} hover:rounded-3xl`;

const titleHiddenWhenMap: any = {
    xs: "xs:inline",
    sm: "sm:inline",
    md: "md:inline",
    lg: "lg:inline",
    xl: "xl:inline",
};
const validTitleHiddenWhen = titleHiddenWhen
    ? titleHiddenWhenMap[titleHiddenWhen]
    : "md:inline";
const textSize = "text-[min(6vw,1rem)]";
const validPadding = givenTitle
    ? `p-3 md:p-4 ${validTitleHiddenWhen}:px-5`
    : "p-3 md:p-4 aspect-square";
const hasTitle = givenTitle ? "hidden" : "hidden!";
const linkClassRepeated = `group flex flex-row flex-stretch items-center justify-center gap-2 ${validPadding} ${validBorderRadius} w-fit h-full font-bold text-[min(6vw,1.2rem)] transition-all duration-250 ease-in-out capitalize`;
const classMap = {
    button: `${linkClassRepeated} bg-L_Primary dark:bg-D_Primary hover:bg-Accent text-LT_Primary dark:text-DT_Primary hover:text-LT_Inverted dark:hover:text-DT_Inverted`,
    activeButton: `${linkClassRepeated} bg-Accent hover:bg-Highlight text-LT_Inverted dark:text-DT_Inverted `,
    titleClass: `${validTitleHiddenWhen} ${textSize} ${hasTitle}`,
};
---

<button onclick={givenFunction} class={classMap.button}>
    <MaterialSymbol
        givenMaterialSymbol={givenSymbol}
        givenMaterialSymbolSize={textSize}
        isFilled={true}
    />
    <p data-i18n={givenTitleData} class={classMap.titleClass}>
        {givenTitle}
    </p>
</button>
