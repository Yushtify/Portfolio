---
import MaterialSymbol from "../materialSymbol.astro";

const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path;

interface Props {
    givenFunction: string;
    givenSymbol?: string;

    givenLocationFrom?: "horizontal" | "vertical";
    givenLocation?: "start" | "center" | "end";

    givenTitle?: string;
    givenTitleData?: string;
}

const {
    givenFunction,
    givenSymbol,
    givenLocationFrom,
    givenLocation,
    givenTitle,
    givenTitleData,
} = Astro.props;

// validate button rounded
const borderRadiusMap = {
    horizontal: {
        start: "rounded-xl rounded-l-3xl",
        center: "rounded-xl",
        end: "rounded-xl rounded-r-3xl",
    },
    vertical: {
        start: "rounded-xl rounded-t-3xl",
        center: "rounded-xl",
        end: "rounded-xl rounded-b-3xl",
    },
} as const;

const borderRadius =
    givenLocationFrom && givenLocation
        ? borderRadiusMap[givenLocationFrom][givenLocation]
        : "rounded-3xl";
const validBorderRadius = `${borderRadius} hover:rounded-3xl`;

const textSize = "text-[min(6vw,1rem)]";
const hasTitle = givenTitle ? "inline" : "hidden";
const classMap = {
    button: `group flex flex-row-reverse lg:flex-row flex-stretch items-center justify-between lg:justify-center gap-4 p-4 max-lg:pl-6 lg:pr-6 ${validBorderRadius} min-w-fit w-full lg:w-fit h-full bg-L_Primary dark:bg-D_Primary hover:bg-Accent font-semibold text-LT_Primary dark:text-DT_Primary hover:text-LT_Inverted dark:hover:text-DT_Inverted transition-all duration-250 ease-in-out cursor-pointer capitalize`,
    titleClass: `${textSize} ${hasTitle}`,
};
---

<button onclick={givenFunction} class={classMap.button}>
    <div class="flex flex-row p-4 rounded-3xl bg-L_BG dark:bg-D_BG group-hover:bg-Highlight transition-colors duration-250 ease-in-out">
        <MaterialSymbol
            givenMaterialSymbol={givenSymbol}
            givenMaterialSymbolSize={textSize}
            isFilled={true}
        />
    </div>
    <p data-i18n={givenTitleData} class={classMap.titleClass}>
        {givenTitle}
    </p>
</button>
