---
import MaterialSymbol from "../materialSymbol.astro";

const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path;

interface Props {
    givenHref: string;
    givenSymbol?: string;

    givenLocationFrom?: "horizontal" | "vertical";
    givenLocation?: "start" | "center" | "end";

    givenTitle?: string;
    givenTitleData?: string;
}

const {
    givenHref,
    givenSymbol,
    givenLocationFrom,
    givenLocation,
    givenTitle,
    givenTitleData,
} = Astro.props;

// validate button rounded
const borderRadiusMap = {
    horizontal: {
        start: "rounded-xl rounded-l-3xl",
        center: "rounded-xl",
        end: "rounded-xl rounded-r-3xl",
    },
    vertical: {
        start: "rounded-xl rounded-t-3xl",
        center: "rounded-xl",
        end: "rounded-xl rounded-b-3xl",
    },
} as const;

const borderRadius =
    givenLocationFrom && givenLocation
        ? borderRadiusMap[givenLocationFrom][givenLocation]
        : "rounded-3xl";
const validBorderRadius = `${borderRadius} hover:rounded-3xl`;

const textSize = "text-[min(6vw,1rem)]";
const validPadding = givenTitle ? `p-2` : "p-2 aspect-square";
const hasTitle = givenTitle ? "" : "!hidden";
const linkClassRepeated = `group flex flex-row flex-stretch items-center justify-center gap-2 ${validPadding} ${validBorderRadius} w-fit h-full font-bold text-[min(6vw,1.2rem)] transition-all duration-250 ease-in-out capitalize`;
const classMap = {
    linkClass: `${linkClassRepeated} bg-L_Primary dark:bg-D_Primary hover:bg-Accent text-LT_Primary dark:text-DT_Primary hover:text-LT_Inverted dark:hover:text-DT_Inverted`,
    activeLinkClass: `${linkClassRepeated} bg-Accent hover:bg-Highlight text-LT_Inverted dark:text-DT_Inverted `,
    titleClass: `hidden md:inline mr-2 ${textSize} ${hasTitle}`,
    symbolContainer:
        "flex flex-row p-4 rounded-3xl bg-L_BG dark:bg-D_BG group-hover:bg-Highlight transition-colors duration-250 ease-in-out",
    activeSymbolContainer:
        "flex flex-row p-4 rounded-3xl bg-Highlight group-hover:bg-LightAccent transition-colors duration-250 ease-in-out",
};
---

<a
    href={givenHref}
    class={isActive(givenHref) ? classMap.activeLinkClass : classMap.linkClass}
>
    <div
        class={
            isActive(givenHref)
                ? classMap.activeSymbolContainer
                : classMap.symbolContainer
        }
    >
        <MaterialSymbol
            givenMaterialSymbol={givenSymbol}
            givenMaterialSymbolSize={textSize}
            isFilled={isActive(givenHref) ? true : false}
        />
    </div>
    <p data-i18n={givenTitleData} class={classMap.titleClass}>
        {givenTitle}
    </p>
</a>
