---
import MaterialSymbol from "./materialSymbol.astro";

interface Props {
    givenHref: string;
    givenTitle: string;
    givenTitleKey: string;
}

const { givenHref, givenTitle, givenTitleKey } = Astro.props;
---

<a
    href={givenHref}
    data-i18n={givenTitleKey}
    class="text-[min(6vw,1rem)] text-LT_Primary dark:text-DT_Primary hover:text-Accent hover:underline decoration-wavy hover:underline-offset-4 transition-all duration-250 ease-in-out"
>
    {givenTitle}
</a>
