---
const { pathname } = Astro.url;
---

<div class="flex flex-col items-start justify-center w-fit h-fit">
    <p class="font-bold text-[min(10vw,6rem)]">404</p>
    <div class="flex flex-row flex-wrap items-center justify-start gap-2">
        <p>Couldn't find following path</p>
        <div class="flex flex-row items-center justify-center rounded-3xl p-2 px-4 bg-L_Primary dark:bg-D_Primary">
            <p>{pathname}</p>
        </div>
        <p>there might be a typo or an issue on our servers</p>
    </div>
</div>
