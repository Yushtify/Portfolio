---
import MaterialSymbol from "../materialSymbol.astro";
import SvgSymbol from "../svgSymbol.astro";

interface Props {
    givenLocationFrom?: "horizontal" | "vertical";
    givenLocation?: "start" | "center" | "end";

    givenSvgSymbol?: string;
    givenSvgSymbolSize?: string;
    givenSvgSymbolViewBox?: string;
    givenMaterialSymbol?: string;

    givenCustomHoverColor?: string;
    givenCustomHoverHighlightColor?: string;

    givenTitle: string;
    givenDesc?: string;
    givenTitleKey: string;
    givenDescKey?: string;
}
const {
    givenLocationFrom,
    givenLocation,
    givenSvgSymbol,
    givenSvgSymbolSize,
    givenSvgSymbolViewBox,
    givenMaterialSymbol,
    givenCustomHoverColor,
    givenCustomHoverHighlightColor,
    givenTitle,
    givenTitleKey,
    givenDesc,
    givenDescKey,
} = Astro.props;

// validate button rounded
const borderRadiusMap = {
    horizontal: {
        start: "rounded-xl rounded-l-3xl",
        center: "rounded-xl",
        end: "rounded-xl rounded-r-3xl",
    },
    vertical: {
        start: "rounded-xl rounded-t-3xl",
        center: "rounded-xl",
        end: "rounded-xl rounded-b-3xl",
    },
} as const;

const classMap = {
    withDesc: {
        title: "text-[min(6vw,0.8rem)] font-bold text-LT_Secondary dark:text-DT_Secondary group-hover:text-LT_Inverted dark:group-hover:text-DT_Inverted uppercase ",
    },
    withoutDesc: {
        title: "text-[min(6vw,1.2rem)] font-semibold capitalize",
    },
};

const borderRadius =
    givenLocationFrom && givenLocation
        ? borderRadiusMap[givenLocationFrom][givenLocation]
        : "rounded-3xl";
const validBorderRadius = `${borderRadius} hover:rounded-3xl`;
const textSize = "text-[min(6vw,1.2rem)]";
---

<div
    class={`group flex flex-col items-start justify-start min-w-fit w-full h-fit p-2 pr-4 md:p-4 md:pr-6 gap-4 ${validBorderRadius} bg-L_Primary dark:bg-D_Primary  hover:text-LT_Inverted dark:hover:text-DT_Inverted hover:bg-Accent shadow-2xl shadow-transparent hover:shadow-Accent/48 hover:-translate-y-2 hover:scale-102 hover:selection:text-Highlight hover:selection:bg-LT_Inverted hover:dark:selection:bg-DT_Inverted transition-all duration-250 ease-in-out select-none`}
>
    <div class="flex flex-row items-center justify-start gap-4">
        <div
            class={`flex flex-row items-center justify-center p-4 rounded-3xl bg-L_BG dark:bg-D_BG group-hover:bg-Highlight transition-colors duration-250 ease-in-out`}
        >
            <SvgSymbol
                givenSvgSymbol={givenSvgSymbol}
                givenSvgSymbolSize={givenSvgSymbolSize}
                givenViewBox={givenSvgSymbolViewBox}
            />
            <MaterialSymbol
                givenMaterialSymbol={givenMaterialSymbol}
                givenMaterialSymbolSize={`!${textSize}`}
                isFilled={true}
            />
        </div>

        <!-- Title & Desc -->
        <div class="flex flex-col items-start justify-center w-fit h-fit">
            <p
                data-i18n={givenTitleKey}
                class={classMap[givenDesc ? "withDesc" : "withoutDesc"].title}
            >
                {givenTitle}
            </p>
            <p data-i18n={givenDescKey}>{givenDesc}</p>
        </div>
    </div>
</div>
