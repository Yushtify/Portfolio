---
interface Props {
    givenLinkGroupName: string;
}

const { givenLinkGroupName } = Astro.props;
---

<!-- Link Group -->
<div class="flex flex-col items-start justify-center gap-4 lg:mx-auto w-fit h-fit">
    <p class="font-semibold text-[min(6vw,1.2rem)] capitalize">
        {givenLinkGroupName}
    </p>
    <div class="flex flex-col items-start justify-center gap-2">
        <slot />
    </div>
</div>
