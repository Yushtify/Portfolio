---
// Needed Variables to run the site
import "../styles/global.css";

// Needed Companents.
import NavBar from "../components/navBar.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/logo.png" />
        <link rel="icon" href="/logo.png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
        />
        <title>Yushtify Portfolio</title>
    </head>
    <body class="relative flex flex-col items-start justify-start gap-4 bg-L_BG dark:bg-D_BG text-[min(6vw,0.9rem)] text-LT_Primary dark:text-DT_Primary caret-Accent selection:text-Accent selection:bg-Accent/36">
        <NavBar />
        <!-- Main Content -->
        <div class="flex flex-col items-start justify-start gap-4 p-4 w-full min-h-screen h-fit">
            <slot />
        </div>
    </body>
</html>
